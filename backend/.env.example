# Copy to .env and fill in. Never commit the real .env.

# Postgres connection string.
# Option A: your own local Postgres (brew install postgresql@16 / postgres.app)
#   DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/transit_crowding
# Option B: zero-install embedded Postgres via the bundled `pgserver` package
#   (see README "Database" section) — connects over a unix socket:
DATABASE_URL=postgresql+psycopg2://postgres:@/postgres?host=/absolute/path/to/backend/.devpgdata

# Clerk (https://dashboard.clerk.com -> API Keys). Enable "Organizations" and
# Google as a social connection in the Clerk dashboard.
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Your Clerk "Frontend API" host, e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=

FRONTEND_ORIGIN=http://localhost:3000

# Prefix stamped on generated API keys, e.g. tc_live_xxxxx
API_KEY_PREFIX=tc
